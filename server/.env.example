# このファイルを .env にコピーして値を設定する
#   cp .env.example .env
# .env は .gitignore 対象（絶対に git に含めないこと）

# Flaskのセッション署名鍵。ランダムな文字列に変更すること
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-random-value

# 管理画面ログイン
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# 打刻端末との認証キー（client/config.py の API_KEY と一致させる）
API_KEY=changeme

# Gmail送信設定
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@your-domain.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=your-email@your-domain.com

# 月次締め日（デフォルト: 20日締め）
DEFAULT_CUTOFF_DAY=20
